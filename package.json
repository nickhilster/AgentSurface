{
  "name": "agentsurface",
  "version": "0.1.0",
  "description": "Inspects an existing website repo and generates a trustworthy agent-facing interface layer without rewriting the human-facing site.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentsurface": "./dist/cli/index.js",
    "agentsurface-mcp": "./dist/mcp/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "demo:dynamic": "node examples/dynamic-catalog-site/server.mjs",
    "test": "vitest run src examples",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "js-yaml": "^4.1.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "6.0.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
